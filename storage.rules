rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin" ||
         request.auth.token.email == "jihadhossan10000@gmail.com");
    }

    // Public avatars and review attachments
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Chat attachments
    match /chat_attachments/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Admin uploads (products, categories, banners)
    match /products/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
